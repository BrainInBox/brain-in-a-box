# Keep LF in the repo on every platform — Python/JSON hooks and shell scripts
# break if checked out with CRLF on Windows.
* text=auto eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.pdf  binary
*.zip  binary

# Codex's own output, captured as it was (some Windows captures hold CRLF): bytes kept as they are.
engine/tests/fixtures/codex/** -text
