{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brain in a Box",
  "version": "0.1.0",
  "identifier": "com.braininbox.installer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Brain in a Box",
        "width": 780,
        "height": 680,
        "minWidth": 620,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "category": "Productivity",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
