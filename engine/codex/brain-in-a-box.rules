# brain-in-a-box: gbq's two reads, run by Codex without asking and outside its sandbox (gbq writes a
# lock in ~/.gbrain and asks Voyage AI). Nothing else: gbq passes every argument to gbrain, and its
# other commands (sync, embed, skillify <url>...) still ask first. Installed by install.sh; a version
# you change is kept, the new one waits in ~/.brain-in-a-box/pending.
#
# host_executable: a path to a gbq counts only when it is the kit's. Without it, Codex would match
# any program named gbq against these rules, ./gbq included, which the sandbox lets a session write.
host_executable(name="gbq", paths=["__HOME__/.local/bin/gbq"])
prefix_rule(pattern=["gbq", "query"], decision="allow")
prefix_rule(pattern=["gbq", "search"], decision="allow")
